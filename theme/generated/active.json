    "stateSelected": "#383838",
    "borderSubtle": "#1affffff",
    "borderStrong": "#66ffffff",
    "success": "#6b9b6b",
    "warning": "#c49b54",
    "error": "#c45050",
    "info": "#668eaa",
    "decorative": "#b0b0b0",
