{
  "id": "nocturne",
  "name": "Nocturne",
  "appearance": "dark",
  "wallpaper": "$HOME/.config/wallpapers/dark_wallpaper_1.png",
  "identity": {
    "ascii": "$HOME/.config/ascii/arachne.txt"
  },
  "effects": {
    "terminalOpacity": 0.5
  },
  "components": {
    "foot": "foot.ini",
    "hyprland": "hyprland.conf",
    "neovim": "nvim.lua"
  },
  "quickshell": {
    "surfaceBase": "#0a0a0a",
    "surfaceRaised": "#171717",
    "surfaceOverlay": "#202020",
    "textPrimary": "#fafafa",
    "textSecondary": "#c8c8c8",
    "textMuted": "#8c8c8c",
    "textDisabled": "#555555",
    "accent": "#d8d8d8",
    "onAccent": "#0a0a0a",
