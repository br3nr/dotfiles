{
  "id": "daylight",
  "name": "Daylight",
  "appearance": "light",
  "wallpaper": "$HOME/.config/wallpapers/light_wallpaper.png",
  "identity": {
    "ascii": "$HOME/.config/ascii/arachne-wire.txt"
  },
  "effects": {
    "terminalOpacity": 0.5
  },
  "components": {
    "foot": "foot.ini",
    "hyprland": "hyprland.conf",
    "neovim": "nvim.lua"
  },
  "quickshell": {
    "surfaceBase": "#f4f1ea",
    "surfaceRaised": "#ece7dd",
    "surfaceOverlay": "#e4ded3",
    "textPrimary": "#1f1c16",
    "textSecondary": "#514b42",
    "textMuted": "#736b5f",
    "textDisabled": "#aaa194",
    "accent": "#3f392f",
    "onAccent": "#f4f1ea",
    "stateHover": "#ddd6c9",
    "statePressed": "#d2c9ba",
    "stateSelected": "#c8bead",
    "borderSubtle": "#24000000",
    "borderStrong": "#66000000",
    "success": "#4f7a4f",
    "warning": "#9a6b2f",
    "error": "#b0463c",
    "info": "#4f7186",
    "decorative": "#5e5548",
    "decorativeMuted": "#9a907f",
    "fontFamily": "PP Fraktion Mono",
    "fontSizeSmall": 10,
    "fontSizeNormal": 12,
    "spacingXs": 2,
    "spacingSm": 4,
    "spacingMd": 8,
    "spacingLg": 12,
    "itemRadius": 2,
    "animationDuration": 200,
    "barHeight": 32,
    "symbolBarHeight": 24
